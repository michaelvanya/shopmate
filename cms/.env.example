# Sanity project and dataset used by the storefront and Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-24
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333/studio

# Keep these aligned with the NEXT_PUBLIC_SANITY_* values for standalone Studio.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_API_VERSION=2026-11-24

# Server-only Sanity token for order capture and the demo seed script.
SANITY_API_TOKEN=

# Server-only Stripe keys for checkout and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000