NODE_ENV=development
PORT=5000
# Comma-separated list of frontend URLs allowed to call this API
FRONTEND_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Only set when frontend and API are on different parent domains in production (usually leave empty)
COOKIE_DOMAIN=

# --- First-time setup ---
# The first person to open the app creates the admin account on the "Create admin account" screen.
# On a public server, set a key so nobody else can claim it first. The setup screen will ask for it.
SETUP_KEY=

# --- Database ---
DATABASE_URL=postgres://user:pass@host:5432/identity
DB_SSL=false
DB_SYNC=true

# --- Multi-tenant identity accounts (optional) ---
MULTI_TENANT_ENABLED=false
# REGISTRY_DATABASE_URL defaults to DATABASE_URL.
# REGISTRY_DATABASE_URL=postgres://user:pass@host:5432/identity_registry
MASTER_ENCRYPTION_KEY=
TENANT_DB_PREFIX=identity_tenant_

# --- Login security ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Optional: only allow admin sign-in from these IPs (comma-separated). Leave empty to allow any.
ADMIN_ALLOWED_IPS=
